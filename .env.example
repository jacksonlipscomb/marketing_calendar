# Copy this file to `.env` and fill in the values from your Supabase project.
# Only public-safe, RLS-governed values belong here. They are embedded in the
# client bundle at build time.
#
# NEVER put the service-role key or RESEND_API_KEY here or anywhere in the repo.
# The service-role key is auto-injected into the edge function runtime, and
# RESEND_API_KEY lives only in Supabase edge-function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
